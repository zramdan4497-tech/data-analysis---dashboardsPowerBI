-- Core measures
Total Sales = SUM ( Orders[Sales] )

Total Profit = SUM ( Orders[Profit] )

Profit Margin % = DIVIDE ( [Total Profit], [Total Sales] )

Orders Count = DISTINCTCOUNT ( Orders[Order ID] )

Total Quantity = SUM ( Orders[Quantity] )

Avg Order Value = DIVIDE ( [Total Sales], [Orders Count] )

Avg Discount = AVERAGE ( Orders[Discount] )

-- Time intelligence (requires a marked Calendar table)
Sales LY = CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )

Sales YoY % = DIVIDE ( [Total Sales] - [Sales LY], [Sales LY] )

Profit LY = CALCULATE ( [Total Profit], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )

Profit YoY % = DIVIDE ( [Total Profit] - [Profit LY], [Profit LY] )

Sales Running Total =
CALCULATE (
    [Total Sales],
    DATESYTD ( 'Calendar'[Date] )
)

-- Ranking and contribution
Category Rank by Sales =
RANKX ( ALL ( Orders[Category] ), [Total Sales],, DESC, DENSE )

Sales % of Total =
DIVIDE ( [Total Sales], CALCULATE ( [Total Sales], ALL ( Orders ) ) )

-- Card helper
Top Product by Sales =
FIRSTNONBLANK (
    TOPN ( 1, VALUES ( Orders[Product Name] ), [Total Sales] ),
    1
)

-- Calendar table (create as a calculated table)
